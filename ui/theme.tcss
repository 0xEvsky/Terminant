# ui/themes.tcss

Screen {
    layout: vertical;
    background: #000000;
    color: #ffffff;
}

#app-container {
    width: 1fr;
    height: auto;
    min-height: 1fr;
    layout: vertical;
}

#body-container {
    width: 1fr;
    height: auto;
    min-height: 1fr;
    layout: horizontal;
}

#main-pane {
    width: 1fr;
    height: auto;
    min-height: 1fr;
    layout: vertical;
}

#chat-view {
    width: 1fr;
    height: auto;
    min-height: 0;
    layout: vertical;
}

#chat-spacer {
    width: 1fr;
    height: 1fr;
    min-height: 0;
}

#message-display {
    width: 1fr;
    height: auto;
    border: none;
    padding: 1 1;
    background: #000000;
    color: #ffffff;
}

#input-bar {
    width: 1fr;
    height: auto;
    border-top: solid #ffffff;
    border-bottom: solid #ffffff;
    padding: 0;
    background: #000000;
    color: #ffffff;
}

#input-row {
    width: 1fr;
    height: auto;
    layout: horizontal;
}

#prompt-symbol {
    width: 2;
    height: 1;
    padding: 0 0 0 1;
    color: #ffffff;
}

#user-input {
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 12;
    margin: 0;
    border: none;
    padding: 0;
    background: #000000;
    color: #ffffff;
}

#user-input:focus {
    border: none;
    background: #000000;
    color: #ffffff;
}

#user-input:disabled {
    opacity: 1;
    background: #000000;
    color: #ffffff;
}

#logs-view {
    display: none;
}

#log-display {
    width: 1fr;
    height: 1fr;
    padding: 1;
    background: #000000;
    color: #ffffff;
}

#message-display:focus,
#log-display:focus {
    border: none;
    background: #000000;
    color: #ffffff;
}