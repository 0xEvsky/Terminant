# ui/themes.tcss

Screen {
    layout: vertical;
    background: $surface;
}

#app-container {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#body-container {
    width: 1fr;
    height: 1fr;
    layout: horizontal;
}

#main-pane {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#chat-view {
    width: 1fr;
    height: 1fr;
    layout: vertical;
}

#message-display {
    width: 1fr;
    height: 1fr;
    border: solid $primary;
    overflow: auto;
    padding: 1;
}

#input-bar {
    width: 1fr;
    height: auto;
    border: solid $primary;
    padding: 1;
}

#user-input {
    width: 1fr;
    margin: 1;
}

#logs-view {
    width: 42;
    min-width: 32;
    height: 1fr;
    border: solid $secondary;
}

#log-display {
    width: 1fr;
    height: 1fr;
    overflow: auto;
    padding: 1;
}